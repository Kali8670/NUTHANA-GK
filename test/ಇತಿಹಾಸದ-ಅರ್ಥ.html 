            { q: "ಮಾನವ ಬಳಸಿದ ಮೊದಲ ಲೋಹ ಯಾವುದು?", options: ["ತಾಮ್ರ", "ಚಿನ್ನ", "ಬೆಳ್ಳಿ", "ಸೀಸ"], answer: 0, exp: "ಮಾನವ ಬಳಸಿದ ಮೊದಲ ಲೋಹ ತಾಮ್ರ." },
            { q: "ತಾಮ್ರ ಯುಗವನ್ನು ಇಂಗ್ಲಿಷ್‌ನಲ್ಲಿ ಏನೆಂದು ಕರೆಯುತ್ತಾರೆ?", options: ["Chalcolithic Age", "Megalithic Age", "Neolithic Age", "Paleolithic Age"], answer: 0, exp: "ಅ) ತಾಮ್ರ ಯುಗ - Chalcolithic Age." },
            { q: "ಕಬ್ಬಿಣ ಯುಗವನ್ನು ಇಂಗ್ಲಿಷ್‌ನಲ್ಲಿ ಏನೆಂದು ಕರೆಯುತ್ತಾರೆ?", options: ["Megalithic Age", "Chalcolithic Age", "Bronze Age", "Stone Age"], answer: 0, exp: "ಬ) ಕಬ್ಬಿಣ ಯುಗ – Megalithic Age." },
            { q: "'Chalco' ಎಂದರೆ ಗ್ರೀಕ್ ಭಾಷೆಯಲ್ಲಿ ಏನೆಂದು ಅರ್ಥ?", options: ["ತಾಮ್ರ", "ಶಿಲೆ", "ಕಬ್ಬಿಣ", "ಚಿನ್ನ"], answer: 0, exp: "Chalco ಎಂದರೆ ತಾಮ್ರ." },
            { q: "'Lithic' ಪದದ ಅರ್ಥವೇನು?", options: ["ಶಿಲೆ", "ಲೋಹ", "ಮಣ್ಣು", "ನೀರು"], answer: 0, exp: "Lithic ಎಂದರೆ ಶಿಲೆ." },
            { q: "ಕಂಚು ತಯಾರಿಸಲು ತಾಮ್ರದೊಂದಿಗೆ ಯಾವ ಲೋಹವನ್ನು 9:1 ಅನುಪಾತದಲ್ಲಿ ಬೆರೆಸುತ್ತಿದ್ದರು?", options: ["ತವರ", "ಸೀಸ", "ಯತು", "ಅಲ್ಯೂಮಿನಿಯಂ"], answer: 0, exp: "ಈ ಯುಗದಲ್ಲಿ ತಾಮ್ರದೊಂದಿಗೆ (9:1) ತವರವನ್ನು ಬಳಸಿಕೊಂಡು ಕಂಚನ್ನು ತಯಾರಿಸಿದರು." },
            { q: "ತಮಿಳುನಾಡಿನ ತಿನ್ನವೇಲಿ ಜಿಲ್ಲೆಯ ಆದಿಚ್ಚನಲ್ಲೂರಿನಲ್ಲಿ ಯಾವ ಲೋಹದ ಅವಶೇಷಗಳು ಕಂಡುಬಂದಿವೆ?", options: ["ಕಬ್ಬಿಣ", "ತಾಮ್ರ", "ಚಿನ್ನ", "ಬೆಳ್ಳಿ"], answer: 0, exp: "ತಮಿಳುನಾಡಿನ ತಿನ್ನವೇಲಿ ಜಿಲ್ಲೆಯ ಆದಿಚ್ಚನಲ್ಲೂರಿನಲ್ಲಿ ಕಬ್ಬಿಣದ ಅವಶೇಷಗಳು ಕಂಡುಬಂದಿವೆ." },
            { q: "ಮಾನವನು ಬೃಹತ್ ಬಂಡೆಗಳನ್ನು ಕೊರೆದು ಸಮಾಧಿಗಳನ್ನು ನಿರ್ಮಿಸುತ್ತಿದ್ದ ಸಂಸ್ಕೃತಿಯನ್ನು ಏನೆಂದು ಕರೆಯುತ್ತಾರೆ?", options: ["ಬೃಹತ್ ಶಿಲಾ ಸಂಸ್ಕೃತಿ (Megalithic Culture)", "ಸೂಕ್ಷ್ಮ ಶಿಲಾ ಸಂಸ್ಕೃತಿ", "ಹಳೆಯ ಶಿಲಾ ಸಂಸ್ಕೃತಿ", "ನೂತನ ಶಿಲಾ ಸಂಸ್ಕೃತಿ"], answer: 0, exp: "ಮಾನವ ಈ ಯುಗದಲ್ಲಿ ಬೃಹತ್ ಬಂಡೆಗಳನ್ನು ಕೊರೆದು ಸಮಾಧಿಗಳನ್ನು ನಿರ್ಮಿಸುತ್ತಿದ್ದನು." },
            { q: "ಕರ್ನಾಟಕದಲ್ಲಿ ಬೃಹತ್ ಶಿಲಾ ಸಂಸ್ಕೃತಿಯ ಸಮಾಧಿಗಳು ಕಂಡುಬಂದ ಬೆಳಗಾವಿ ಜಿಲ್ಲೆಯ ಪ್ರಸಿದ್ಧ ಸ್ಥಳ ಯಾವುದು?", options: ["ಕೊಣ್ಣೂರು", "ಲಿಂಗಸೂರು", "ಹುಣಸಗಿ", "ನಿಟ್ಟೂರು"], answer: 0, exp: "ಬೆಳಗಾವಿ ಜಿಲ್ಲೆಯ ಕೊಣ್ಣೂರು." },
            { q: "ಬೃಹತ್ ಶಿಲಾ ಸಂಸ್ಕೃತಿಯ ಸಮಾಧಿಗಳು ಪತ್ತೆಯಾದ ಯಾದಗಿರಿ ಜಿಲ್ಲೆಯ ಪ್ರಮುಖ ಸ್ಥಳ ಯಾವುದು?", options: ["ರಾಜನ ಕೊಳೂರು", "ಕಿಬ್ಬನಹಳ್ಳಿ", "ಬ್ರಹ್ಮಗಿರಿ", "ಟಿ. ನರಸೀಪುರ"], answer: 0, exp: "ಯಾದಗಿರಿ ಜಿಲ್ಲೆಯ ರಾಜನ ಕೊಳೂರು." }
        ];

        let currentQuestion = 0;
        let score = 0;
        let userAnswers = new Array(quizData.length).fill(null);
        let isCompleted = false;

        function initQuiz() {
            buildPalette();
            loadQuestion(0);
        }

        function buildPalette() {
            const grid = document.getElementById('palette-grid');
            grid.innerHTML = '';
            for (let i = 0; i < quizData.length; i++) {
                const btn = document.createElement('button');
                btn.className = 'palette-btn';
                btn.innerText = i + 1;
                btn.onclick = () => jumpToQuestion(i);
                grid.appendChild(btn);
            }
            updatePaletteStyles();
        }

        function loadQuestion(index) {
            currentQuestion = index;
            const q = quizData[index];

            document.getElementById('q-meta').innerText = `Question ${index + 1} of ${quizData.length}`;
            document.getElementById('q-title').innerText = `${index + 1}. ${q.q}`;

            const optionsList = document.getElementById('options-list');
            optionsList.innerHTML = '';

            q.options.forEach((opt, i) => {
                const div = document.createElement('div');
                div.className = 'option-container';
                div.innerText = `${String.fromCharCode(65 + i)}. ${opt}`;
                
                if (userAnswers[index] !== null) {
                    if (i === q.answer) {
                        div.classList.add('correct');
                    } else if (i === userAnswers[index]) {
                        div.classList.add('wrong');
                    }
                } else {
                    div.onclick = () => selectOption(i);
                }
                optionsList.appendChild(div);
            });

            const expBox = document.getElementById('explanation-box');
            if (userAnswers[index] !== null) {
                document.getElementById('explanation-text').innerText = q.exp;
                expBox.style.display = 'block';
            } else {
                expBox.style.display = 'none';
            }

            document.getElementById('prev-btn').style.display = index === 0 ? 'none' : 'inline-block';
            document.getElementById('next-btn').style.display = index === quizData.length - 1 ? 'none' : 'inline-block';
            
            updatePaletteStyles();
        }

        function selectOption(selectedIndex) {
            if (userAnswers[currentQuestion] !== null) return;

            userAnswers[currentQuestion] = selectedIndex;
            const correctIndex = quizData[currentQuestion].answer;

            if (selectedIndex === correctIndex) {
                score++;
            }

            document.getElementById('score-display').innerText = `Score: ${score} / ${quizData.length}`;
            loadQuestion(currentQuestion);
            
            if (userAnswers.every(ans => ans !== null)) {
                isCompleted = true;
                document.getElementById('retest-btn').style.display = 'inline-block';
            }
        }

        function changeQuestion(direction) {
            const nextIndex = currentQuestion + direction;
            if (nextIndex >= 0 && nextIndex < quizData.length) {
                loadQuestion(nextIndex);
            }
        }

        function jumpToQuestion(index) {
            loadQuestion(index);
        }

        function updatePaletteStyles() {
            const buttons = document.querySelectorAll('.palette-btn');
            buttons.forEach((btn, idx) => {
                btn.classList.remove('current', 'answered-correct', 'answered-wrong');
                
                if (idx === currentQuestion) {
                    btn.classList.add('current');
                }

                if (userAnswers[idx] !== null) {
                    if (userAnswers[idx] === quizData[idx].answer) {
                        btn.classList.add('answered-correct');
                    } else {
                        btn.classList.add('answered-wrong');
                    }
                }
            });
        }

        function resetQuiz() {
            userAnswers = new Array(quizData.length).fill(null);
            score = 0;
            isCompleted = false;
            document.getElementById('score-display').innerText = `Score: 0 / ${quizData.length}`;
            document.getElementById('retest-btn').style.display = 'none';
            loadQuestion(0);
        }

        window.onload = initQuiz;
    </script>

            { q: "ಬ್ರಹ್ಮಗಿರಿ ನೆಲೆ ಎಲ್ಲಿದೆ?", options: ["ಚಿತ್ರದುರ್ಗ", "ಮೈಸೂರು", "ಬೆಳಗಾವಿ", "ರಾಯಚೂರು"], answer: 0, exp: "ಬ್ರಹ್ಮಗಿರಿ (ಚಿತ್ರದುರ್ಗ)." },
            { q: "ನೂತನ ಶಿಲಾಯುಗಕ್ಕೆ ಸೇರಿದ ಟಿ. ನರಸೀಪುರ ನೆಲೆ ಎಲ್ಲಿದೆ?", options: ["ಮೈಸೂರು", "ತುಮಕೂರು", "ಬಳ್ಳಾರಿ", "ಯಾದಗಿರಿ"], answer: 0, exp: "ಟಿ. ನರಸೀಪುರ (ಮೈಸೂರು)." },

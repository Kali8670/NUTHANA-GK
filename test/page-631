<!DOCTYPE html>
<html lang="kn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Karnataka PC & SSC CBT Exam Mock Test</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #f4f6f9;
            color: #333;
        }

        .header {
            background-color: #1a365d;
            color: white;
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: bold;
        }

        .container {
            display: flex;
            flex-wrap: wrap;
            max-width: 1200px;
            margin: 20px auto;
            gap: 20px;
            padding: 0 10px;
        }

        .main-quiz {
            flex: 2;
            min-width: 300px;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .sidebar {
            flex: 1;
            min-width: 250px;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            height: fit-content;
        }

        .question-title {
            font-size: 1.1rem;
            margin-bottom: 20px;
            font-weight: 600;
            line-height: 1.5;
        }

        .options-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 20px;
        }

        .option-btn {
            background-color: #f8f9fa;
            border: 1px solid #ced4da;
            padding: 12px 15px;
            border-radius: 6px;
            text-align: left;
            cursor: pointer;
            font-size: 0.95rem;
            transition: all 0.2s;
        }

        .option-btn:hover {
            background-color: #e9ecef;
        }

        .option-btn.selected {
            background-color: #d1e7dd;
            border-color: #a3cfbb;
            color: #0f5132;
        }

        .option-btn.correct {
            background-color: #d1e7dd !important;
            border-color: #0f5132 !important;
            color: #0f5132;
            font-weight: bold;
        }

        .option-btn.incorrect {
            background-color: #f8d7da !important;
            border-color: #842029 !important;
            color: #842029;
        }

        .explanation-box {
            display: none;
            padding: 15px;
            border-radius: 6px;
            margin-top: 15px;
            font-size: 0.95rem;
            line-height: 1.4;
        }

        .explanation-box.wrong {
            background-color: #f8d7da;
            color: #842029;
            border: 1px solid #f5c2c7;
        }

        .explanation-box.right {
            background-color: #d1e7dd;
            color: #0f5132;
            border: 1px solid #badbcc;
        }

        .nav-buttons {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }

        .btn {
            padding: 8px 18px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            color: white;
            background-color: #0d6efd;
        }

        .btn:disabled {
            background-color: #ccc;
            cursor: not-allowed;
        }

        .btn-retest {
            background-color: #ffc107;
            color: #000;
        }

        .palette-title {
            font-weight: bold;
            margin-bottom: 10px;
            text-align: center;
        }

        .score-board {
            text-align: center;
            margin-bottom: 15px;
            font-size: 0.9rem;
            color: #6c757d;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .grid-btn {
            padding: 8px;
            border: 1px solid #ccc;
            background: #f8f9fa;
            border-radius: 4px;
            cursor: pointer;
            text-align: center;
            font-weight: bold;
        }

        .grid-btn.answered {
            background-color: #0d6efd;
            color: white;
        }

        .grid-btn.active {
            border: 2px solid #000;
        }
    </style>
</head>
<body>

    <div class="header">
        <span>Karnataka PC & SSC CBT Exam Mock Test</span>
        <span>ಜೀವಶಾಸ್ತ್ರ ಅಭ್ಯಾಸ ಪರೀಕ್ಷೆ</span>
    </div>

    <div class="container">
        <div class="main-quiz">
            <div class="question-title" id="question-text">ಪ್ರಶ್ನೆ ಇಲ್ಲಿ ಮೂಡುತ್ತದೆ...</div>
            <div class="options-container" id="options-container"></div>
            
            <div id="explanation-box" class="explanation-box"></div>

            <div class="nav-buttons">
                <button class="btn" id="prev-btn" onclick="prevQuestion()">Previous</button>
                <button class="btn btn-retest" onclick="resetQuiz()">Retest 🔄</button>
                <button class="btn" id="next-btn" onclick="nextQuestion()">Next</button>
            </div>
        </div>

        <div class="sidebar">
            <div class="palette-title">Question Palette</div>
            <div class="score-board" id="score-board">Score: 0 / 12</div>
            <div class="grid" id="question-palette"></div>
        </div>
    </div>

    <script>
        const quizData = [
            {
                q: "1. ಸಸ್ಯಗಳನ್ನು ಕುರಿತು ಅಧ್ಯಯನ ಮಾಡುವ ವಿಜ್ಞಾನದ ಶಾಖೆಯನ್ನು ಏನೆಂದು ಕರೆಯುತ್ತಾರೆ?",
                options: ["ಪ್ರಾಣಿಶಾಸ್ತ್ರ", "ಸಸ್ಯಶಾಸ್ತ್ರ", "ಸೂಕ್ಷ್ಮಣು ಜೀವಶಾಸ್ತ್ರ", "ಕೋಶೀಯ ವಿಜ್ಞಾನ"],
                correct: 1,
                exp: "ಸಸ್ಯಗಳನ್ನು ಕುರಿತು ಅಧ್ಯಯನ ಮಾಡುವ ಶಾಸ್ತ್ರವೇ ಸಸ್ಯಶಾಸ್ತ್ರ (Botany). ಇದರ ಪಿತಾಮಹ ಥಿಯೋ ಫ್ರಾಸ್ಟಸ್."
            },
            {
                q: "2. ಪ್ರಾಣಿಶಾಸ್ತ್ರದ (Zoology) ಪಿತಾಮಹ ಯಾರು?",
                options: ["ಥಿಯೋ ಫ್ರಾಸ್ಟಸ್", "ರಾಬರ್ಟ್ ಹುಕ್", "ಅರಿಸ್ಟಾಟಲ್", "ಲಿನ್ನೇಯಸ್"],
                correct: 2,
                exp: "ಪ್ರಾಣಿಗಳ ಕುರಿತು ಅಧ್ಯಯನ ಮಾಡುವ ಶಾಸ್ತ್ರ ಪ್ರಾಣಿಶಾಸ್ತ್ರ. ಇದರ ಪಿತಾಮಹ ಅರಿಸ್ಟಾಟಲ್."
            },
            {
                q: "3. ಸೂಕ್ಷ್ಮ ಜೀವಿಗಳ ಕುರಿತು ಅಧ್ಯಯನ ಮಾಡುವ ವಿಜ್ಞಾನದ ಶಾಖೆ ಯಾವುದು?",
                options: ["ಸೂಕ್ಷ್ಮಣು ಜೀವಶಾಸ್ತ್ರ", "ಸಸ್ಯಶಾಸ್ತ್ರ", "ಪ್ರಾಣಿಶಾಸ್ತ್ರ", "ಅಂಗರಚನಾ ಶಾಸ್ತ್ರ"],
                correct: 0,
                exp: "ಸೂಕ್ಷ್ಮ ಜೀವಿಗಳ ಕುರಿತು ಅಧ್ಯಯನ ಮಾಡುವ ಶಾಸ್ತ್ರವನ್ನು ಸೂಕ್ಷ್ಮಣು ಜೀವಶಾಸ್ತ್ರ (Microbiology) ಎನ್ನಲಾಗುತ್ತದೆ."
            },
            {
                q: "4. ಮೃದ್ವಂಗಿಗಳ (Molluscs) ಉಸಿರಾಟದ ಅಂಗ ಯಾವುದು?",
                options: ["ನಳಿಕಾಪಾದ", "ಬುಕ್ ಲಂಗ್ಸ್", "ಟಿನೇಡಿಯಾ", "ಚರ್ಮ"],
                correct: 2,
                exp: "ಮೃದ್ವಂಗಿಗಳ ಶ್ವಾಸನಾಳ/ಉಸಿರಾಟದ ಅಂಗ 'ಟಿನೇಡಿಯಾ' ಆಗಿದೆ."
            },
            {
                q: "5. ಕಂಟಕಚರ್ಮಿಗಳು (Echinoderms) ಉಸಿರಾಟಕ್ಕಾಗಿ ಯಾವ ಅಂಗವನ್ನು ಬಳಸುತ್ತವೆ?",
                options: ["ನಳಿಕಾಪಾದ", "ಕಿವಿರು", "ಶ್ವಾಸಕೋಶ", "ಮಿಥ್ಯಾಪಾದ"],
                correct: 0,
                exp: "ಕಂಟಕಚರ್ಮಿಗಳ ಉಸಿರಾಟದ ಅಂಗ 'ನಳಿಕಾಪಾದ'."
            },
            {
                q: "6. ಚೇಳಿನ (Scorpion) ಉಸಿರಾಟದ ಅಂಗ ಯಾವುದು?",
                options: ["ಟಿನೇಡಿಯಾ", "ಬುಕ್ ಲಂಗ್ಸ್", "ಪತ್ರ ರಂಧ್ರಗಳು", "ಚರ್ಮ"],
                correct: 1,
                exp: "ಚೇಳು 'ಬುಕ್ ಲಂಗ್ಸ್' (Book Lungs) ಮೂಲಕ ಉಸಿರಾಡುತ್ತದೆ."
            },
            {
                q: "7. ಅಮೀಬಾದ (Amoeba) ಚಲನಾಂಗ ಯಾವುದು?",
                options: ["ಕಶಾಂಗ", "ಲೋಮಾಂಗ", "ಮಿಥ್ಯಾಪಾದ (ಸೋಡೋ ಪೋಡಿಯಾ)", "ಈಜುರೆಕ್ಕೆ"],
                correct: 2,
                exp: "ಅಮೀಬಾದ ಚಲನಾಂಗ 'ಮಿಥ್ಯಾಪಾದ / ಸೋಡೋ ಪೋಡಿಯಾ'."
            },
            {
                q: "8. ಯುಗ್ಲೀನಾ (Euglena) ಚಲಿಸಲು ಸಹಾಯ ಮಾಡುವ ಅಂಗ ಯಾವುದು?",
                options: ["ಲೋಮಾಂಗ / ಸೀಲಿಯಾ", "ಕರಬಳ್ಳಿ", "ಬಿರುಗೂದಲು", "ನಳಿಕಾಪಾದ"],
                correct: 0,
                exp: "ಯುಗ್ಲೀನಾದ ಚಲನಾಂಗ 'ಲೋಮಾಂಗ / ಸೀಲಿಯಾ'."
            },
            {
                q: "9. ಪ್ಯಾರಾಮೀಸಿಯಂ ನ ಚಲನಾಂಗ ಯಾವುದು?",
                options: ["ಮಿಥ್ಯಾಪಾದ", "ಕಶಾಂಗ / ಪ್ಲಾಜಿಲ್ಲಾ", "ಈಜುರೆಕ್ಕೆ", "ಬುಕ್ ಲಂಗ್ಸ್"],
                correct: 1,
                exp: "ಪ್ಯಾರಾಮೀಸಿಯಂ 'ಕಶಾಂಗ / ಪ್ಲಾಜಿಲ್ಲಾ' ಮೂಲಕ ಚಲಿಸುತ್ತದೆ."
            },
            {
                q: "10. ಹೈಡ್ರಾ (Hydra) ಜೀವಿ ಹೊಂದಿರುವ ಚಲನಾಂಗ ಯಾವುದು?",
                options: ["ಕರಬಳ್ಳಿ / ಟೆಂಟಕಲ್", "ಬಿರುಗೂದಲು", "ಮಿಥ್ಯಾಪಾದ", "ಸೀಲಿಯಾ"],
                correct: 0,
                exp: "ಹೈಡ್ರಾದ ಚಲನಾಂಗ 'ಕರಬಳ್ಳಿ / ಟೆಂಟಕಲ್'."
            },
            {
                q: "11. ಎರೆಹುಳುವಿನ (Earthworm) ಚಲನಾಂಗ ಯಾವುದು?",
                options: ["ಟಿನೇಡಿಯಾ", "ನಳಿಕಾಪಾದ", "ಬಿರುಗೂದಲು", "ಈಜುರೆಕ್ಕೆ"],
                correct: 2,
                exp: "ಎರೆಹುಳುವಿನ ಚಲನಾಂಗ 'ಬಿರುಗೂದಲು'."
            },
            {
                q: "12. ಮೀನುಗಳ ಚಲನಾಂಗ ಯಾವುದು?",
                options: ["ಮಿಥ್ಯಾಪಾದ", "ಟೆಂಟಕಲ್", "ಈಜುರೆಕ್ಕೆ", "ಕಶಾಂಗ"],
                correct: 2,
                exp: "ಮೀನುಗಳು ಚಲಿಸಲು 'ಈಜುರೆಕ್ಕೆ'ಗಳನ್ನು ಬಳಸುತ್ತವೆ."
            }
        ];

        let currentQuestion = 0;
        let userAnswers = new Array(quizData.length).fill(null);

        function loadQuiz() {
            renderPalette();
            showQuestion();
        }

        function showQuestion() {
            const qData = quizData[currentQuestion];
            document.getElementById("question-text").innerText = qData.q;
            
            const optionsContainer = document.getElementById("options-container");
            optionsContainer.innerHTML = "";

            const expBox = document.getElementById("explanation-box");
            expBox.style.display = "none";

            qData.options.forEach((opt, index) => {
                const btn = document.createElement("button");
                btn.className = "option-btn";
                btn.innerText = opt;

                if (userAnswers[currentQuestion] !== null) {
                    if (index === qData.correct) {
                        btn.classList.add("correct");
                    }
                    if (userAnswers[currentQuestion] === index && index !== qData.correct) {
                        btn.classList.add("incorrect");
                    }
                    btn.disabled = true;
                } else {
                    btn.onclick = () => selectOption(index);
                }

                optionsContainer.appendChild(btn);
            });

            if (userAnswers[currentQuestion] !== null) {
                expBox.style.display = "block";
                if (userAnswers[currentQuestion] === qData.correct) {
                    expBox.className = "explanation-box right";
                    expBox.innerHTML = `<b>ಸರಿಯಾದ ಉತ್ತರ!</b><br>${qData.exp}`;
                } else {
                    expBox.className = "explanation-box wrong";
                    expBox.innerHTML = `<b>ತಪ್ಪು ಉತ್ತರ (Incorrect)</b><br>ಸರಿಯಾದ ಉತ್ತರ: <b>${qData.options[qData.correct]}</b><br>ವಿವರಣೆ: ${qData.exp}`;
                }
            }

            document.getElementById("prev-btn").disabled = currentQuestion === 0;
            document.getElementById("next-btn").disabled = currentQuestion === quizData.length - 1;

            updatePaletteUI();
            updateScore();
        }

        function selectOption(index) {
            userAnswers[currentQuestion] = index;
            showQuestion();
        }

        function renderPalette() {
            const palette = document.getElementById("question-palette");
            palette.innerHTML = "";
            quizData.forEach((_, index) => {
                const btn = document.createElement("div");
                btn.className = "grid-btn";
                btn.innerText = index + 1;
                btn.onclick = () => {
                    currentQuestion = index;
                    showQuestion();
                };
                palette.appendChild(btn);
            });
        }

        function updatePaletteUI() {
            const buttons = document.querySelectorAll(".grid-btn");
            buttons.forEach((btn, idx) => {
                btn.classList.remove("active", "answered");
                if (idx === currentQuestion) btn.classList.add("active");
                if (userAnswers[idx] !== null) btn.classList.add("answered");
            });
        }

        function updateScore() {
            let score = 0;
            userAnswers.forEach((ans, idx) => {
                if (ans === quizData[idx].correct) score++;
            });
            document.getElementById("score-board").innerText = `Score: ${score} / ${quizData.length}`;
        }

        function nextQuestion() {
            if (currentQuestion < quizData.length - 1) {
                currentQuestion++;
                showQuestion();
            }
        }

        function prevQuestion() {
            if (currentQuestion > 0) {
                currentQuestion--;
                showQuestion();
            }
        }

        function resetQuiz() {
            userAnswers = new Array(quizData.length).fill(null);
            currentQuestion = 0;
            loadQuiz();
        }

        loadQuiz();
    </script>
</body>
</html>

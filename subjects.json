<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuthana GK</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0d1117;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            padding: 30px 15px;
        }

        .container {
            width: 100%;
            max-width: 520px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Glowing Neon Title */
        h1.title {
            color: #00ff88;
            font-size: 30px;
            font-weight: 800;
            letter-spacing: 1.5px;
            margin-bottom: 6px;
            text-align: center;
            text-shadow: 0 0 10px rgba(0, 255, 136, 0.6), 
                         0 0 20px rgba(0, 255, 136, 0.4);
        }

        p.subtitle {
            color: #8b949e;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 1.5px;
            margin-bottom: 25px;
            text-align: center;
            text-transform: uppercase;
        }

        #menu-container {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        /* Main Subject Card */
        .main-card {
            background-color: #161b22;
            border: 1px solid #30363d;
            border-radius: 12px;
            padding: 16px 20px;
            transition: all 0.2s ease-in-out;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
        }

        .main-card:hover {
            border-color: #00ff88;
        }

        .main-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 18px;
            font-weight: 700;
            color: #ffffff;
            cursor: pointer;
            user-select: none;
        }

        .arrow {
            color: #8b949e;
            font-size: 12px;
            transition: transform 0.3s ease;
        }

        /* Sub-subject container */
        .sub-container {
            display: none;
            margin-top: 15px;
            padding-left: 8px;
            border-left: 2px solid #00ff88;
        }

        .sub-group {
            margin-bottom: 12px;
        }

        .sub-subject-title {
            color: #00ff88;
            font-size: 15px;
            font-weight: 600;
            margin: 10px 0 6px 0;
        }

        /* Chapter Links */
        .chapter-link {
            display: block;
            background-color: #21262d;
            color: #e6edf3;
            text-decoration: none;
            padding: 10px 14px;
            margin-bottom: 6px;
            border-radius: 8px;
            font-size: 14px;
            border: 1px solid #30363d;
            transition: background 0.2s, color 0.2s;
        }

        .chapter-link:hover {
            background-color: #30363d;
            color: #00ff88;
        }

        .loading-text {
            color: #8b949e;
            text-align: center;
            font-size: 14px;
            margin-top: 20px;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1 class="title">NUTHANA GK</h1>
        <p class="subtitle">Select Main Subject</p>

        <div id="menu-container">
            <p class="loading-text">Loading subjects structure...</p>
        </div>
    </div>

    <script>
        fetch('subjects.json')
            .then(response => response.json())
            .then(data => {
                const container = document.getElementById('menu-container');
                container.innerHTML = '';

                data.mainSubjects.forEach(main => {
                    const mainCard = document.createElement('div');
                    mainCard.className = 'main-card';

                    let subHtml = '';
                    main.subSubjects.forEach(sub => {
                        let chaptersHtml = '';
                        sub.chapters.forEach(chap => {
                            chaptersHtml += `<a href="${chap.fileUrl}" class="chapter-link">${chap.title}</a>`;
                        });

                        // Show section title only if sub-subject name is defined
                        if (sub.name && sub.name.trim() !== '') {
                            subHtml += `
                                <div class="sub-group">
                                    <div class="sub-subject-title">📁 ${sub.name}</div>
                                    <div class="chapter-list">${chaptersHtml}</div>
                                </div>
                            `;
                        } else {
                            subHtml += `<div class="sub-group"><div class="chapter-list">${chaptersHtml}</div></div>`;
                        }
                    });

                    mainCard.innerHTML = `
                        <div class="main-header">
                            <span>${main.name}</span>
                            <span class="arrow">▼</span>
                        </div>
                        <div class="sub-container">${subHtml}</div>
                    `;

                    // Accordion click handler
                    const header = mainCard.querySelector('.main-header');
                    header.addEventListener('click', () => {
                        const subContainer = mainCard.querySelector('.sub-container');
                        const arrow = mainCard.querySelector('.arrow');
                        const isVisible = subContainer.style.display === 'block';

                        // Close all open sub-containers
                        document.querySelectorAll('.sub-container').forEach(sc => sc.style.display = 'none');
                        document.querySelectorAll('.arrow').forEach(a => a.style.transform = 'rotate(0deg)');

                        // Toggle current
                        if (!isVisible) {
                            subContainer.style.display = 'block';
                            arrow.style.transform = 'rotate(180deg)';
                        }
                    });

                    container.appendChild(mainCard);
                });
            })
            .catch(error => {
                document.getElementById('menu-container').innerHTML = '<p class="loading-text" style="color: #ff5555;">Error loading subjects.json file.</p>';
                console.error(error);
            });
    </script>

</body>
</html>
